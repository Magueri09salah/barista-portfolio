# Copy to .env and fill in. .env* is gitignored — never commit the real one.
#
# One file, two readers: the Prisma CLI loads .env (via dotenv in
# prisma7.config.ts) and Next.js loads it at runtime. The Prisma CLI does NOT
# read .env.local, which is why everything lives here instead.

# ------------------------------------------------------------------ Database
# Postgres. On Neon: project → Connect → copy the connection string.
#
#   DATABASE_URL   used by the running app. Use the POOLED string — its host
#                  contains "-pooler".
#   DIRECT_URL     used by the Prisma CLI for migrations and Studio. A
#                  migration issues session-level statements that PgBouncer in
#                  transaction mode cannot carry, so it needs a direct endpoint.
#
# To build DIRECT_URL: take your DATABASE_URL and delete the six characters
# "-pooler" from the host. Change NOTHING else — not the region, not the
# cluster prefix, not the query string. Both lines must be character-for-
# character identical apart from those six characters, or you get
# "P1000: Authentication failed", which reads like a wrong password but is
# actually a wrong host.
#
#   pooled   ...@ep-cool-name-a1b2c3-pooler.c-4.us-east-2.aws.neon.tech/...
#   direct   ...@ep-cool-name-a1b2c3.c-4.us-east-2.aws.neon.tech/...
#                                   ^^^^^^^ only this is removed
#
# On a plain Postgres with a single endpoint, set DATABASE_URL only.
# NOTE: this file IS committed. Never put real credentials here — they belong in
# .env, which is gitignored.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ---------------------------------------------------------------- Back office
# Password for the back office at /admin. Without this, /admin refuses every
# request rather than opening itself to the internet.
ADMIN_PASSWORD=change-me-to-something-long

# Signs the session cookie. Optional: falls back to ADMIN_PASSWORD, but setting
# it means changing the password does not have to invalidate your session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=
